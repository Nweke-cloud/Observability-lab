global:
  resolve_timeout: 5m
  smtp_smarthost: 'smtp.gmail.com:587'
  smtp_from: 'GMAIL_ADDRESS_PLACEHOLDER'
  smtp_auth_username: 'GMAIL_ADDRESS_PLACEHOLDER'
  smtp_auth_password: 'GMAIL_PASSWORD_PLACEHOLDER'
  smtp_require_tls: true

route:
  group_by: ['alertname', 'instance']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  receiver: 'all-receivers'
  routes:
    - match:
        severity: critical
      receiver: 'critical-all'
      continue: false
    - match:
        severity: warning
      receiver: 'warning-all'
      continue: false

receivers:

  - name: 'warning-all'
    slack_configs:
      - api_url: 'SLACK_WARNING_PLACEHOLDER'
        channel: '#observability-warnings'
        send_resolved: true
        title: '[{{ .Status | toUpper }}] {{ .CommonLabels.alertname }}'
        text: >-
          {{ range .Alerts }}
          *Alert:* {{ .Labels.alertname }}
          *Severity:* {{ .Labels.severity }}
          *Instance:* {{ .Labels.instance }}
          *Description:* {{ .Annotations.description }}
          {{ end }}
        color: '{{ if eq .Status "firing" }}warning{{ else }}good{{ end }}'
    email_configs:
      - to: 'GMAIL_ADDRESS_PLACEHOLDER'
        headers:
          Subject: '[WARNING] {{ .CommonLabels.alertname }} on {{ .CommonLabels.instance }}'
        html: |
          <h2>Alert: {{ .CommonLabels.alertname }}</h2>
          <p>Status: {{ .Status | toUpper }}</p>
          <p>Severity: warning</p>
          {{ range .Alerts }}
          <p>Instance: {{ .Labels.instance }}</p>
          <p>Description: {{ .Annotations.description }}</p>
          <p>Started: {{ .StartsAt }}</p>
          {{ end }}
        send_resolved: true
    webhook_configs:
      - url: 'http://host.docker.internal:5001/webhook'
        send_resolved: true

  - name: 'critical-all'
    slack_configs:
      - api_url: 'SLACK_CRITICAL_PLACEHOLDER'
        channel: '#observability-critical'
        send_resolved: true
        title: ':rotating_light: [CRITICAL] {{ .CommonLabels.alertname }}'
        text: >-
          {{ range .Alerts }}
          *Alert:* {{ .Labels.alertname }}
          *Severity:* :red_circle: CRITICAL
          *Instance:* {{ .Labels.instance }}
          *Description:* {{ .Annotations.description }}
          {{ end }}
        color: 'danger'
    email_configs:
      - to: 'GMAIL_ADDRESS_PLACEHOLDER'
        headers:
          Subject: '[CRITICAL] {{ .CommonLabels.alertname }} on {{ .CommonLabels.instance }}'
        html: |
          <h2>CRITICAL ALERT - IMMEDIATE ACTION REQUIRED</h2>
          <p>Alert: {{ .CommonLabels.alertname }}</p>
          <p>Status: {{ .Status | toUpper }}</p>
          {{ range .Alerts }}
          <p>Instance: {{ .Labels.instance }}</p>
          <p>Description: {{ .Annotations.description }}</p>
          <p>Started: {{ .StartsAt }}</p>
          {{ end }}
        send_resolved: true
    webhook_configs:
      - url: 'http://host.docker.internal:5001/webhook'
        send_resolved: true

  - name: 'all-receivers'
    webhook_configs:
      - url: 'http://host.docker.internal:5001/webhook'
        send_resolved: true

inhibit_rules:
  - source_match:
      severity: 'critical'
    target_match:
      severity: 'warning'
    equal: ['alertname', 'instance']
